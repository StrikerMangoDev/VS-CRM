[Unit]
Description=Load VS CRM runtime secrets from Google Secret Manager
Wants=network-online.target
After=network-online.target
Before=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/vscrm/fetch-secrets.py
RemainAfterExit=yes
RuntimeDirectory=vscrm
RuntimeDirectoryMode=0700
UMask=0077
TimeoutStartSec=240
